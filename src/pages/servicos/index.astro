---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServicesHero from '@/components/sections/servicos/ServicesHero.astro';
import ServicesExplorer from '@/components/sections/servicos/ServicesExplorer.astro';
import ServicesDifferentials from '@/components/sections/servicos/ServicesDifferentials.astro';
import ProcessTimeline from '@/components/sections/shared/ProcessTimeline.astro';
import OfferBand from '@/components/sections/shared/OfferBand.astro';
import { site, services } from '@/data/site';

const description = `Serviços de TI corporativa em ${site.address.city} — ${site.address.state}: ${services.map((s) => s.title).join(', ')}.`;

// The page closes with OfferBand (free diagnosis) instead of the old generic ServicesCta:
// two stacked CTA panels diluted each other, and the concrete zero-risk offer converts
// better (Alfa #5). It is the closer, so the footer skips its own big CTA (footerCta={false}).

// Structured data: the service catalog offered by the business.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Serviços — ${site.name}`,
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.title,
      description: s.summary,
      url: `${site.url}/servicos/#${s.slug}`,
      areaServed: `${site.address.city}, ${site.address.state}`,
      provider: { '@type': 'LocalBusiness', name: site.name, url: site.url },
    },
  })),
};
---

<BaseLayout title="Serviços" description={description} footerCta={false}>
  <ServicesHero />
  <ServicesExplorer />
  <ServicesDifferentials />
  <ProcessTimeline tight />
  <OfferBand />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
