---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import { nav, site } from '@/data/site';

const host = new URL(site.url).host;
---

<BaseLayout title="Link perdido" description="A página que você procura não foi encontrada. Volte para a rede da FortLink Soluções.">
  <section class="lost" aria-labelledby="lost-title">
    <div class="lost-grid" aria-hidden="true"></div>
    <p class="lost-code" aria-hidden="true">404</p>

    <div class="container lost-inner">
      <svg class="lost-link" viewBox="0 0 800 140" aria-hidden="true" focusable="false" data-reveal="fade">
        <defs>
          <linearGradient id="lost-grad" x1="40" x2="380" y1="0" y2="0" gradientUnits="userSpaceOnUse">
            <stop offset="0" style="stop-color: var(--c-cyan)"></stop>
            <stop offset="1" style="stop-color: var(--c-blue)"></stop>
          </linearGradient>
        </defs>

        <!-- Live side: signal leaves the user and dies at the break. -->
        <path class="lost-cable" d="M48 70 H300 C334 70 350 78 366 96"></path>
        <path class="lost-pulse" d="M48 70 H300 C334 70 350 78 366 96" pathLength="100"></path>

        <!-- Dead side: dashed, no signal. -->
        <path class="lost-cable lost-cable--dead" d="M752 70 H500 C466 70 450 60 434 44"></path>

        <g class="lost-sparks">
          <path d="M372 100 l12 6"></path>
          <path d="M370 106 l6 12"></path>
          <path d="M376 96 l14 -2"></path>
          <path d="M428 40 l-12 -6"></path>
          <path d="M430 34 l-4 -12"></path>
        </g>

        <g class="lost-node">
          <circle class="lost-node-ring" cx="48" cy="70" r="16"></circle>
          <circle class="lost-node-core" cx="48" cy="70" r="5"></circle>
          <text x="48" y="118" text-anchor="middle">VOCÊ</text>
        </g>
        <g class="lost-node lost-node--dead">
          <circle class="lost-node-ring" cx="752" cy="70" r="16"></circle>
          <circle class="lost-node-core" cx="752" cy="70" r="5"></circle>
          <text x="752" y="118" text-anchor="middle">DESTINO</text>
        </g>
      </svg>

      <p class="eyebrow" data-reveal>Erro 404 · conexão interrompida</p>
      <h1 id="lost-title" class="lost-title t-display" data-split="chars" data-split-delay="0.1">
        Link <span class="text-gradient">perdido.</span>
      </h1>
      <p class="lost-lead muted" data-reveal data-reveal-delay="0.1">
        A conexão com esta página caiu. Ela pode ter mudado de endereço ou nunca ter existido — mas a nossa rede
        continua de pé. Vamos te levar de volta.
      </p>

      <div class="lost-term" role="group" aria-label="Diagnóstico da conexão" data-reveal data-reveal-delay="0.15">
        <p><span class="lost-prompt" aria-hidden="true">$</span> ping {host}<span data-lost-path></span></p>
        <p class="lost-err">Tempo esgotado para a requisição.</p>
        <p class="lost-dim">4 pacotes enviados · 0 recebidos · 100% de perda</p>
        <p><span class="lost-prompt" aria-hidden="true">$</span> <span class="lost-caret" aria-hidden="true"></span></p>
      </div>

      <div class="lost-actions" data-reveal data-reveal-delay="0.2">
        <Button href="/" variant="primary" icon="arrow-right" magnetic>Voltar para o início</Button>
        <Button href="/contato/" variant="ghost">Falar com a gente</Button>
      </div>

      <nav class="lost-nav" aria-label="Páginas sugeridas" data-reveal data-reveal-delay="0.25">
        <span class="lost-nav-label">Rotas disponíveis</span>
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: 100svh;
    padding-top: calc(var(--header-h) + var(--sp-7));
    padding-bottom: var(--sp-9);
    overflow: hidden;
  }

  .lost-grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(60% 55% at 50% 45%, #000, transparent 85%);
    -webkit-mask-image: radial-gradient(60% 55% at 50% 45%, #000, transparent 85%);
  }

  .lost-grid::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(40% 35% at 50% 40%, color-mix(in srgb, var(--c-magenta) 16%, transparent), transparent 70%);
  }

  .lost-code {
    position: absolute;
    inset: 50% auto auto 50%;
    z-index: -1;
    transform: translate(-50%, -58%);
    font-family: var(--font-display);
    font-size: calc(var(--fs-hero) * 3);
    line-height: 1;
    letter-spacing: -0.02em;
    color: transparent;
    -webkit-text-stroke: 1px var(--line);
    white-space: nowrap;
    user-select: none;
    pointer-events: none;
    animation: lost-flicker 5s steps(1) infinite;
  }

  @keyframes lost-flicker {
    0%,
    100% {
      opacity: 1;
    }
    92% {
      opacity: 0.35;
    }
    94% {
      opacity: 1;
    }
    96% {
      opacity: 0.5;
    }
  }

  .lost-inner {
    display: grid;
    justify-items: center;
    gap: var(--sp-5);
    text-align: center;
  }

  /* ---------- Broken link illustration ---------- */
  .lost-link {
    width: min(100%, 640px);
    height: auto;
    overflow: visible;
    margin-bottom: var(--sp-4);
  }

  .lost-cable,
  .lost-pulse,
  .lost-sparks path {
    fill: none;
    stroke-linecap: round;
  }

  .lost-cable {
    stroke: url(#lost-grad);
    stroke-width: 2;
    opacity: 0.55;
  }

  .lost-cable--dead {
    stroke: var(--line-strong);
    stroke-dasharray: 3 7;
    opacity: 1;
  }

  .lost-pulse {
    stroke: var(--c-cyan);
    stroke-width: 3;
    stroke-dasharray: 12 88;
    filter: drop-shadow(0 0 6px var(--c-cyan));
    animation: lost-pulse 2.4s var(--ease-in-out) infinite;
  }

  @keyframes lost-pulse {
    0% {
      stroke-dashoffset: 12;
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      stroke-dashoffset: -88;
      opacity: 0;
    }
  }

  .lost-sparks path {
    stroke: var(--c-pink);
    stroke-width: 1.5;
    opacity: 0;
    animation: lost-spark 2.4s var(--ease-out) infinite;
  }

  .lost-sparks path:nth-child(n + 4) {
    stroke: var(--c-magenta);
    animation-delay: 0.12s;
  }

  @keyframes lost-spark {
    0%,
    82% {
      opacity: 0;
    }
    88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  .lost-node-ring {
    fill: var(--bg);
    stroke: var(--c-cyan);
    stroke-width: 1;
  }

  .lost-node-core {
    fill: var(--c-cyan);
    filter: drop-shadow(0 0 6px var(--c-cyan));
  }

  .lost-node text {
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    letter-spacing: 0.2em;
    fill: var(--text-muted);
  }

  .lost-node--dead .lost-node-ring {
    stroke: var(--line-strong);
    stroke-dasharray: 2 4;
  }

  .lost-node--dead .lost-node-core {
    fill: var(--text-dim);
    filter: none;
  }

  .lost-node--dead text {
    fill: var(--text-dim);
  }

  /* ---------- Copy ---------- */
  .lost-title {
    max-width: none;
  }

  .lost-lead {
    max-width: 52ch;
    font-size: var(--fs-md);
  }

  .lost-term {
    width: min(100%, 520px);
    padding: var(--sp-4) var(--sp-5);
    text-align: left;
    font-family: ui-monospace, 'SFMono-Regular', Consolas, monospace;
    font-size: var(--fs-sm);
    line-height: 1.8;
    color: var(--text);
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    overflow-wrap: anywhere;
  }

  .lost-prompt {
    color: var(--accent);
    margin-right: var(--sp-1);
  }

  .lost-err {
    color: var(--c-pink);
  }

  .lost-dim {
    color: var(--text-muted);
  }

  .lost-caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    vertical-align: -0.2em;
    background: var(--accent);
    animation: lost-caret 1.1s steps(1) infinite;
  }

  @keyframes lost-caret {
    50% {
      opacity: 0;
    }
  }

  .lost-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-3);
    margin-top: var(--sp-3);
  }

  .lost-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3) var(--sp-5);
    margin-top: var(--sp-5);
    font-size: var(--fs-sm);
  }

  .lost-nav-label {
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .lost-nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-2);
    list-style: none;
    padding: 0;
  }

  .lost-nav a {
    display: inline-block;
    padding: var(--sp-1) var(--sp-4);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    color: var(--text-muted);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .lost-nav a:hover,
  .lost-nav a:focus-visible {
    color: var(--text);
    border-color: var(--c-cyan);
  }
</style>

<script>
  // Show the path the visitor actually requested (build-time pathname is always /404).
  const slot = document.querySelector('[data-lost-path]');
  if (slot) {
    let p = window.location.pathname;
    try {
      p = decodeURIComponent(p);
    } catch {
      /* keep raw */
    }
    slot.textContent = p.length > 48 ? `${p.slice(0, 45)}…` : p;
  }
</script>
