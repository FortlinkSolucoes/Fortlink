---
/**
 * Alfa #2 — pain → solution. Each row is a sentence in the customer's own voice (left, muted)
 * linked to the service that solves it (right, accent). The whole row is the link.
 */
import { pains, painsHeading, services, whatsappLink } from '@/data/site';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import ShimmerText from '@/components/ui/ShimmerText.astro';

interface Props {
  id?: string;
}

const { id = 'problemas' } = Astro.props;

const rows = pains.flatMap((pain, i) => {
  const service = services.find((s) => s.slug === pain.slug);
  return service ? [{ n: String(i + 1).padStart(2, '0'), text: pain.text, slug: service.slug, title: service.title }] : [];
});

const title = `${painsHeading.title} <span class="pains__accent">${painsHeading.accent}</span>`;
---

<section class="pains section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container">
    <SectionHeading id={`${id}-title`} eyebrow={painsHeading.eyebrow} title={title} lead={painsHeading.lead} />

    <ol class="pains__list" role="list" data-stagger>
      {
        rows.map((row) => (
          <li class="pain">
            <a class="pain__link" href={`/servicos/?abrir=${row.slug}#${row.slug}`}>
              <span class="pain__n" aria-hidden="true">
                {row.n}
              </span>
              <span class="pain__text">{row.text}</span>
              <span class="pain__fix">
                <span class="sr-only">Solução: </span>
                <span>{row.title}</span>
                <Icon name="arrow-right" size={18} class="pain__arrow" />
              </span>
              <span class="pain__trace" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ol>

    <div class="pains__closing">
      <!-- One infinite accent per block: the shimmer. The label stays a plain eyebrow. -->
      <p class="eyebrow" data-reveal="fade">{painsHeading.closingLabel}</p>
      <div data-reveal="up">
        <ShimmerText as="p" class="pains__closing-text">{painsHeading.closing}</ShimmerText>
      </div>
      <div data-reveal="up" data-reveal-delay="0.15">
        <Button href={whatsappLink(painsHeading.whatsappText)} variant="ghost" icon="whatsapp" external>
          Falar no WhatsApp
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .pains :global(.pains__accent) {
    color: var(--accent);
  }

  .pains__list {
    list-style: none;
    padding: 0;
    margin-top: var(--head-gap);
    border-top: 1px solid var(--line);
  }

  .pain {
    border-bottom: 1px solid var(--line);
  }

  .pain__link {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: var(--sp-2) var(--sp-4);
    padding: var(--sp-5) var(--sp-3);
    border-radius: var(--r-sm);
    transition: background-color var(--dur) var(--ease-out);
  }

  .pain__n {
    grid-row: span 2;
    padding-top: 0.3em;
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    color: var(--text-dim);
    transition: color var(--dur) var(--ease-out);
  }

  .pain__text {
    font-family: var(--font-heading);
    font-size: var(--fs-lg);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--text-muted);
    transition: color var(--dur) var(--ease-out);
  }

  .pain__fix {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-heading);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--accent);
  }

  .pain__fix :global(.pain__arrow) {
    flex: none;
    transition: transform var(--dur) var(--ease-out);
  }

  /* Circuit trace: a thin line with a node at its head, drawn along the row's bottom edge. */
  .pain__trace {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--c-cyan) 70%);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-slow) var(--ease-out);
    pointer-events: none;
  }

  .pain__trace::after {
    content: '';
    position: absolute;
    right: -3px;
    top: -2px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--c-cyan);
    box-shadow: var(--glow-sm);
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .pain__link:is(:hover, :focus-visible) {
    background-color: color-mix(in srgb, var(--c-mist) 4%, transparent);
  }

  .pain__link:is(:hover, :focus-visible) .pain__text {
    color: var(--text);
  }

  .pain__link:is(:hover, :focus-visible) .pain__n {
    color: var(--accent);
  }

  .pain__link:is(:hover, :focus-visible) :global(.pain__arrow) {
    transform: translateX(6px);
  }

  .pain__link:is(:hover, :focus-visible) .pain__trace {
    transform: scaleX(1);
  }

  .pain__link:is(:hover, :focus-visible) .pain__trace::after {
    opacity: 1;
    transition-delay: calc(var(--dur-slow) * 0.6);
  }

  /* Closing: live dot label + big shimmering line + CTA. */
  .pains__closing {
    display: grid;
    justify-items: start;
    gap: var(--sp-5);
    margin-top: var(--sp-9);
  }

  .pains :global(.pains__closing-text) {
    max-width: 16ch;
  }

  @media (min-width: 960px) {
    .pain__link {
      grid-template-columns: 3.5rem minmax(0, 1.5fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--sp-6);
      padding: var(--sp-5) var(--sp-4);
    }

    .pain__n {
      grid-row: auto;
      padding-top: 0;
    }

    .pain__fix {
      justify-self: end;
      font-size: var(--fs-md);
      text-align: right;
    }

    .pains__closing {
      justify-items: center;
      text-align: center;
    }
  }
</style>
