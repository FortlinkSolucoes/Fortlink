---
/**
 * Single service detail modal (Alfa #3). Native <dialog> + showModal (focus trap,
 * Esc, top layer for free). Content comes from `services` in site.ts, serialized
 * once as JSON; src/scripts/service-dialog.ts fills it for the clicked card.
 */
import Icon from '@/components/ui/Icon.astro';
import ServiceIcon from '@/components/ui/ServiceIcon.astro';
import Button from '@/components/ui/Button.astro';
import { services, serviceWhatsapp, whatsappLink } from '@/data/site';
import type { ServiceDialogItem } from '@/scripts/service-dialog';

const total = String(services.length).padStart(2, '0');
const items: ServiceDialogItem[] = services.map((s, i) => ({
  slug: s.slug,
  num: String(i + 1).padStart(2, '0'),
  title: s.title,
  summary: s.summary,
  details: s.details,
  cta: `Falar sobre ${s.title}`,
  href: serviceWhatsapp(s.title),
  form: `/contato/?servico=${s.slug}`,
}));
// Escape "<" so the JSON can never close its <script> early.
const json = JSON.stringify(items).replace(/</g, '\\u003c');
---

<!-- data-lenis-prevent sits on the dialog: it is the element that scrolls (the panel can outgrow the viewport). -->
<dialog class="sdlg" aria-labelledby="sdlg-title" aria-describedby="sdlg-summary" data-svc-dialog data-lenis-prevent>
  <div class="sdlg__panel" data-sdlg-panel>
    <span class="sdlg__orb" aria-hidden="true"></span>

    <button class="sdlg__x" type="button" aria-label="Fechar detalhes do serviço" data-sdlg-close>
      <Icon name="close" size={18} />
    </button>

    <div class="sdlg__head">
      <span class="sdlg__icons">
        {
          services.map((s) => (
            <span data-sdlg-icon={s.slug} hidden>
              <ServiceIcon name={s.icon} size={28} />
            </span>
          ))
        }
      </span>
      <p class="sdlg__num" aria-hidden="true"><span data-sdlg-num>01</span><span>/{total}</span></p>
    </div>

    <h2 class="sdlg__title" id="sdlg-title" data-sdlg-title></h2>
    <p class="sdlg__summary" id="sdlg-summary" data-sdlg-summary></p>

    <h3 class="sdlg__label">O que fazemos neste serviço</h3>
    <ul class="sdlg__chips" data-sdlg-details></ul>

    <div class="sdlg__actions">
      <Button href={whatsappLink()} variant="primary" icon="whatsapp" external pulse data-sdlg-cta>
        <span data-sdlg-cta-label>Falar sobre este serviço</span>
      </Button>
      <Button variant="ghost" data-sdlg-close>Fechar</Button>
    </div>

    <p class="sdlg__offer">
      <span>Prefere por escrito? <a href="/contato/" data-sdlg-form>Enviar pelo formulário</a></span>
    </p>
  </div>

  <script type="application/json" data-sdlg-data set:html={json} />
</dialog>

<style>
  /* The dialog box itself is the full-viewport scrim (dim + blur), so tokens apply
     (::backdrop doesn't inherit custom properties everywhere) and a click on it = outside. */
  .sdlg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: var(--gutter);
    border: 0;
    color: var(--text);
    background: color-mix(in srgb, var(--c-night) 72%, transparent);
    -webkit-backdrop-filter: blur(10px) saturate(120%);
    backdrop-filter: blur(10px) saturate(120%);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* Auto margins center the panel but collapse to 0 when it's taller than the
     viewport, so the top stays reachable (place-items:center would clip it). */
  .sdlg[open] {
    display: grid;
  }

  .sdlg::backdrop {
    background: transparent;
  }

  :global(html:has(.sdlg[open])) {
    overflow: hidden;
  }

  .sdlg__panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    gap: var(--sp-4);
    width: min(100%, 40rem);
    margin: auto;
    padding: clamp(var(--sp-5), 5vw, var(--sp-7));
    border-radius: var(--r-xl);
    background: var(--bg-elev-solid);
    box-shadow: 0 40px 120px -40px color-mix(in srgb, var(--c-night) 90%, transparent);
  }

  /* 1px gradient hairline (mask keeps the fill). */
  .sdlg__panel::before {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    background: var(--grad-border);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    pointer-events: none;
  }

  /* Single accent: a quiet radial from the bottom corner (Alfa overlay). */
  .sdlg__orb {
    position: absolute;
    z-index: -1;
    right: -30%;
    bottom: -60%;
    width: 90%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--c-cyan) 16%, transparent), transparent 65%);
    pointer-events: none;
  }

  .sdlg__x {
    position: absolute;
    top: var(--sp-4);
    right: var(--sp-4);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--text-muted);
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  .sdlg__x:hover,
  .sdlg__x:focus-visible {
    color: var(--text);
    border-color: var(--c-cyan);
    transform: rotate(90deg);
  }

  .sdlg__x:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .sdlg__head {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    padding-right: var(--sp-8);
    margin-bottom: var(--sp-2);
  }

  .sdlg__num {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    letter-spacing: 0.12em;
  }

  .sdlg__num span + span {
    color: var(--text-dim);
  }

  .sdlg__title {
    font-size: var(--fs-xl);
    line-height: 1.1;
    max-width: 20ch;
  }

  .sdlg__summary {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--fs-md);
  }

  .sdlg__label {
    margin-top: var(--sp-3);
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .sdlg__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sdlg__chips :global(li) {
    padding: var(--sp-2) var(--sp-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    font-size: var(--fs-sm);
    background: color-mix(in srgb, var(--c-ink) 60%, transparent);
  }

  .sdlg__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
    margin-top: var(--sp-5);
  }

  .sdlg__actions :global(.btn) {
    white-space: normal;
    text-align: left;
  }

  .sdlg__offer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-5);
    margin: 0;
    padding-top: var(--sp-4);
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .sdlg__offer a {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }

  .sdlg__offer a:hover,
  .sdlg__offer a:focus-visible {
    text-decoration-color: var(--c-cyan);
  }

  /* Enter / exit: scrim fades, panel scales up from slightly below. */
  .sdlg[open] {
    animation: sdlg-fade var(--dur) var(--ease-out);
  }

  .sdlg[open] .sdlg__panel {
    animation: sdlg-in var(--dur-slow) var(--ease-out);
  }

  .sdlg[data-closing] {
    animation: sdlg-fade var(--dur-fast) var(--ease-in-out) reverse forwards;
  }

  .sdlg[data-closing] .sdlg__panel {
    animation: sdlg-out var(--dur-fast) var(--ease-in-out) forwards;
  }

  @keyframes sdlg-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes sdlg-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.96);
    }
  }

  @keyframes sdlg-out {
    to {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sdlg[open],
    .sdlg[open] .sdlg__panel {
      animation: none;
    }

    .sdlg__x {
      transition: none;
    }

    .sdlg__x:hover,
    .sdlg__x:focus-visible {
      transform: none;
    }
  }
</style>

<script>
  import { initServiceDialog } from '@/scripts/service-dialog';

  initServiceDialog();
</script>
