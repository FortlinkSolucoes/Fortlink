---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import { whatsappLink } from '@/data/site';
---

<section class="section section--tight cta" data-svc-cta>
  <div class="container">
    <div class="cta__panel" data-reveal="scale">
      <svg class="cta__circuit" viewBox="0 0 1200 400" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M0 320 H220 L280 260 H520" pathLength="100" />
        <path d="M1200 80 H980 L920 140 H700" pathLength="100" />
        <path d="M1200 300 H1040 L1000 340 H860" pathLength="100" />
        <path class="cta__pulse" d="M0 320 H220 L280 260 H520" pathLength="100" />
        <path class="cta__pulse cta__pulse--b" d="M1200 80 H980 L920 140 H700" pathLength="100" />
      </svg>
      <span class="cta__orb" aria-hidden="true"></span>

      <div class="cta__content">
        <SectionHeading
          eyebrow="Próximo passo"
          title={'Vamos desenhar a solução <span class="text-gradient">ideal para a sua empresa</span>?'}
          lead="Conte o cenário da sua operação e receba uma proposta clara, com escopo, cronograma e investimento."
          align="center"
        />

        <div class="cta__actions">
          <Button
            href={whatsappLink('Olá FortLink, gostaria de um orçamento para serviços de TI.')}
            variant="primary"
            icon="whatsapp"
            external
            magnetic
          >
            Chamar no WhatsApp
          </Button>
          <Button href="/contato/" variant="ghost" icon="arrow-right">Solicitar orçamento</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta__panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(var(--sp-7), 6vw, var(--sp-10)) clamp(var(--sp-5), 5vw, var(--sp-9));
    border-radius: var(--r-xl);
    background: var(--bg-elev);
  }

  /* Gradient hairline border via mask (keeps the glass fill). */
  .cta__panel::before {
    content: '';
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    background: var(--grad-border);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .cta__circuit {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0.8;
  }

  .cta__circuit path {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
  }

  .cta__circuit .cta__pulse {
    stroke: var(--c-cyan);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 12 112;
    stroke-dashoffset: 14;
    /* A couple of passes while on screen, then the circuit rests. */
    animation: cta-pulse 4.5s linear 2;
  }

  .cta__circuit .cta__pulse--b {
    stroke: var(--c-magenta);
    animation-delay: -2.2s;
    animation-duration: 5.5s;
  }

  .cta[data-paused] .cta__pulse {
    animation-play-state: paused;
  }

  @keyframes cta-pulse {
    to {
      stroke-dashoffset: -100;
    }
  }

  .cta__orb {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 100%;
    width: min(90vw, 900px);
    aspect-ratio: 1;
    translate: -50% -35%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--c-magenta) 35%, transparent) 0%,
      color-mix(in srgb, var(--c-blue) 22%, transparent) 35%,
      transparent 65%
    );
    filter: blur(20px);
    pointer-events: none;
  }

  .cta__content {
    display: grid;
    justify-items: center;
    gap: var(--sp-7);
    text-align: center;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-4);
  }
</style>

<script>
  // Pause the CSS pulses while the CTA is off-screen or the tab is hidden.
  const cta = document.querySelector<HTMLElement>('[data-svc-cta]');
  if (cta) {
    let visible = false;
    const sync = () => cta.toggleAttribute('data-paused', !visible || document.hidden);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      sync();
    }).observe(cta);
    document.addEventListener('visibilitychange', sync);
    sync();
  }
</script>
