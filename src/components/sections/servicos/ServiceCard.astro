---
/**
 * Service card (Alfa #3): hover zooms the pictogram and reveals the scope chips;
 * "Ver detalhes" (whole card is the hit area) opens the shared <ServiceDialog>.
 * The chips live in the card itself, so the scope is readable without JS / by
 * screen readers — the reveal only animates opacity/transform, never hides them.
 */
import GlowCard from '@/components/ui/GlowCard.astro';
import Icon from '@/components/ui/Icon.astro';
import ServiceIcon from '@/components/ui/ServiceIcon.astro';
import Button from '@/components/ui/Button.astro';
import { serviceWhatsapp, type Service } from '@/data/site';

type CardSize = 'sm' | 'md' | 'lg' | 'xl';

interface Props {
  service: Service;
  index: number;
  total: number;
  size?: CardSize;
}

const { service, index, total, size = 'sm' } = Astro.props;
const { slug, icon, title, summary, details } = service;

const num = String(index + 1).padStart(2, '0');
const of = String(total).padStart(2, '0');
const feature = size === 'lg' || size === 'xl';
---

<li class:list={['svc', `svc--${size}`]} id={slug} tabindex="-1" data-svc>
  <GlowCard as="article" class="svc__glow" flush tilt>
    <div class="svc__inner">
      {
        feature && (
          <svg class="svc__deco" viewBox="0 0 220 140" aria-hidden="true" focusable="false">
            <path d="M0 110 H70 L100 80 H160 L190 50 H220" />
            <path d="M40 140 V120 L60 100 H120" />
            <path d="M130 0 V30 L150 50 H220" />
            <circle cx="100" cy="80" r="3" />
            <circle cx="160" cy="80" r="3" />
            <circle cx="150" cy="50" r="3" />
            <path class="svc__deco-pulse" d="M0 110 H70 L100 80 H160 L190 50 H220" pathLength="100" />
          </svg>
        )
      }

      <div class="svc__top">
        <span class="svc__media"><ServiceIcon name={icon} size={feature ? 30 : 26} /></span>
        <span class="svc__index" aria-hidden="true">{num}<span>/{of}</span></span>
      </div>

      <h3 class="svc__title">{title}</h3>
      <p class="svc__summary">{summary}</p>

      <ul class="svc__chips" aria-label={`O que fazemos em ${title}`}>
        {details.map((d, i) => <li style={`--i: ${i}`}>{d}</li>)}
      </ul>

      <div class="svc__foot">
        <button
          class="svc__open"
          type="button"
          aria-haspopup="dialog"
          data-svc-open={slug}
          data-cursor="Ver"
        >
          <span class="svc__open-label">Ver detalhes</span>
          <span class="sr-only"> de {title}</span>
          <span class="svc__open-icon" aria-hidden="true"><Icon name="arrow-up-right" size={16} /></span>
        </button>

        <!-- Without JS the dialog can't open: offer the direct conversation instead. -->
        <Button href={serviceWhatsapp(title)} variant="link" icon="arrow-up-right" external class="svc__nojs">
          Falar sobre este serviço
        </Button>
      </div>
    </div>
  </GlowCard>
</li>

<style>
  .svc {
    position: relative;
    list-style: none;
    display: flex;
    min-width: 0;
    scroll-margin-top: calc(var(--header-h) + var(--sp-9));
    border-radius: var(--r-lg);
  }

  .svc:focus {
    outline: none;
  }

  .svc:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 6px;
  }

  .svc > :global(.svc__glow) {
    flex: 1;
    display: flex;
    min-width: 0;
    height: 100%;
  }

  .svc__inner {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    min-width: 0;
    padding: clamp(var(--sp-5), 3vw, var(--sp-6));
  }

  .svc__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: var(--sp-4);
  }

  /* Alfa: the "media" zooms slightly on hover. */
  .svc__media {
    display: inline-flex;
    transition: transform var(--dur-slow) var(--ease-out);
    transform-origin: 0 0;
  }

  .svc:is(:hover, :focus-within) .svc__media {
    transform: scale(1.08);
  }

  .svc__index {
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    letter-spacing: 0.12em;
    color: var(--text);
  }

  .svc__index span {
    color: var(--text-dim);
  }

  .svc__title {
    font-size: var(--fs-lg);
    max-width: 18ch;
  }

  .svc__summary {
    color: var(--text-muted);
    max-width: 46ch;
  }

  .svc--lg .svc__title,
  .svc--xl .svc__title {
    font-size: var(--fs-xl);
  }

  .svc--lg .svc__summary,
  .svc--xl .svc__summary {
    font-size: var(--fs-md);
  }

  /* Decorative circuit on feature cards, painted under the content. */
  .svc__inner > :not(.svc__deco) {
    position: relative;
  }

  .svc__deco {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(55%, 260px);
    height: auto;
    pointer-events: none;
    opacity: 0.6;
  }

  .svc__deco path,
  .svc__deco circle {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.25;
  }

  .svc__deco .svc__deco-pulse {
    stroke: var(--c-cyan);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 14 120;
    stroke-dashoffset: 16;
  }

  .svc:hover .svc__deco-pulse {
    animation: svc-deco 1.6s var(--ease-in-out);
  }

  @keyframes svc-deco {
    to {
      stroke-dashoffset: -104;
    }
  }

  /* Scope chips. Space is always reserved (no layout shift in the bento); on
     fine-pointer devices they rise in on hover/focus, elsewhere they're just shown. */
  .svc__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 52ch;
  }

  .svc__chips li {
    padding: var(--sp-1) var(--sp-3);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    font-size: var(--fs-xs);
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :global(html.js) .svc__chips li {
      opacity: 0;
      transform: translateY(8px);
      transition:
        opacity var(--dur) var(--ease-out),
        transform var(--dur) var(--ease-out);
    }

    :global(html.js) .svc:is(:hover, :focus-within) .svc__chips li {
      opacity: 1;
      transform: none;
      transition-delay: calc(var(--i) * 50ms);
    }
  }

  /* Footer: the button's ::after stretches over the whole card (card = hit area),
     so the footer itself must not be the positioning context. */
  .svc__inner > .svc__foot {
    position: static;
    margin-top: auto;
    padding-top: var(--sp-3);
    border-top: 1px solid var(--line);
  }

  .svc__open {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    width: 100%;
    padding: var(--sp-1) 0;
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: left;
    color: var(--text);
  }

  .svc__open::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: var(--z-base);
    border-radius: var(--r-lg);
  }

  .svc__open:focus-visible {
    outline: none;
  }

  .svc__open:focus-visible::after {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }

  .svc__open-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition:
      transform var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .svc:is(:hover, :focus-within) .svc__open-icon {
    border-color: var(--c-cyan);
    color: var(--c-cyan);
    transform: rotate(45deg);
  }

  :global(html.js) .svc__foot :global(.svc__nojs),
  :global(html:not(.js)) .svc__open {
    display: none;
  }

  /* Deep-link highlight (/servicos/#slug): brief border pulse around the card. */
  .svc::before {
    content: '';
    position: absolute;
    inset: -4px;
    border: 1px solid var(--c-cyan);
    border-radius: calc(var(--r-lg) + 4px);
    opacity: 0;
    pointer-events: none;
  }

  .svc[data-flash]::before {
    animation: svc-flash 0.9s var(--ease-out) 2;
  }

  @keyframes svc-flash {
    0% {
      opacity: 0;
      transform: scale(0.99);
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--c-cyan) 40%, transparent);
    }
    30% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: scale(1.015);
      box-shadow: 0 0 0 10px transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .svc__media,
    .svc__open-icon {
      transition: none;
    }

    .svc:is(:hover, :focus-within) .svc__media {
      transform: none;
    }

    /* Static highlight instead of a pulse; the script removes it after a moment. */
    .svc[data-flash]::before {
      animation: none;
      opacity: 1;
    }
  }
</style>
