---
import GlowCard from '@/components/ui/GlowCard.astro';
import Icon from '@/components/ui/Icon.astro';
import ServiceIcon from '@/components/ui/ServiceIcon.astro';
import Button from '@/components/ui/Button.astro';
import { whatsappLink, type Service } from '@/data/site';

type CardSize = 'sm' | 'md' | 'lg' | 'xl';

interface Props {
  service: Service;
  index: number;
  total: number;
  size?: CardSize;
}

const { service, index, total, size = 'sm' } = Astro.props;
const { slug, icon, title, summary, details } = service;

const num = String(index + 1).padStart(2, '0');
const of = String(total).padStart(2, '0');
const panelId = `${slug}-detalhes`;
const feature = size === 'lg' || size === 'xl';
---

<li class:list={['svc', `svc--${size}`]} id={slug} tabindex="-1" data-svc data-open="false">
  <GlowCard as="article" class="svc__glow" flush tilt>
      <div class="svc__inner">
        {
          feature && (
            <svg class="svc__deco" viewBox="0 0 220 140" aria-hidden="true" focusable="false">
              <path d="M0 110 H70 L100 80 H160 L190 50 H220" />
              <path d="M40 140 V120 L60 100 H120" />
              <path d="M130 0 V30 L150 50 H220" />
              <circle cx="100" cy="80" r="3" />
              <circle cx="160" cy="80" r="3" />
              <circle cx="150" cy="50" r="3" />
              <path class="svc__deco-pulse" d="M0 110 H70 L100 80 H160 L190 50 H220" pathLength="100" />
            </svg>
          )
        }

        <div class="svc__top">
          <ServiceIcon name={icon} size={feature ? 30 : 26} />
          <span class="svc__index" aria-hidden="true">{num}<span>/{of}</span></span>
        </div>

        <h3 class="svc__title">{title}</h3>
        <p class="svc__summary">{summary}</p>

        <button
          class="svc__toggle"
          type="button"
          aria-expanded="false"
          aria-controls={panelId}
          data-svc-toggle
        >
          <span class="svc__toggle-label">O que está incluso</span>
          <span class="sr-only"> em {title}</span>
          <span class="svc__toggle-icon"><Icon name="plus" size={16} /></span>
        </button>

        <div class="svc__panel" id={panelId}>
          <div class="svc__panel-inner">
            <ul class="svc__details">
              {
                details.map((d) => (
                  <li>
                    <Icon name="check" size={16} />
                    <span>{d}</span>
                  </li>
                ))
              }
            </ul>
            <Button
              href={whatsappLink(`Olá FortLink, gostaria de saber mais sobre ${title}.`)}
              variant="link"
              icon="arrow-up-right"
              external
            >
              Falar sobre este serviço
            </Button>
          </div>
        </div>
      </div>
  </GlowCard>
</li>

<style>
  .svc {
    list-style: none;
    display: flex;
    min-width: 0;
    scroll-margin-top: calc(var(--header-h) + var(--sp-9));
    border-radius: var(--r-lg);
  }

  .svc:focus {
    outline: none;
  }

  .svc:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 6px;
  }

  .svc > :global(.svc__glow) {
    flex: 1;
    display: flex;
    min-width: 0;
    height: 100%;
  }

  .svc__inner {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    min-width: 0;
    padding: clamp(var(--sp-5), 3vw, var(--sp-6));
  }

  .svc__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: var(--sp-4);
  }

  .svc__index {
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    letter-spacing: 0.12em;
    color: var(--text);
  }

  .svc__index span {
    color: var(--text-dim);
  }

  .svc__title {
    font-size: var(--fs-lg);
    max-width: 18ch;
  }

  .svc__summary {
    color: var(--text-muted);
    max-width: 46ch;
  }

  .svc--lg .svc__title,
  .svc--xl .svc__title {
    font-size: var(--fs-xl);
  }

  .svc--lg .svc__summary,
  .svc--xl .svc__summary {
    font-size: var(--fs-md);
  }

  /* Decorative circuit on feature cards, painted under the content. */
  .svc__inner > :not(.svc__deco) {
    position: relative;
  }

  .svc__deco {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(55%, 260px);
    height: auto;
    pointer-events: none;
    opacity: 0.6;
  }

  .svc__deco path,
  .svc__deco circle {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.25;
  }

  .svc__deco .svc__deco-pulse {
    stroke: var(--c-cyan);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 14 120;
    stroke-dashoffset: 16;
  }

  .svc:hover .svc__deco-pulse {
    animation: svc-deco 1.6s var(--ease-in-out);
  }

  @keyframes svc-deco {
    to {
      stroke-dashoffset: -104;
    }
  }

  /* Disclosure */
  .svc__toggle {
    position: relative;
    z-index: var(--z-base);
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-top: auto;
    padding: var(--sp-3) 0;
    border-top: 1px solid var(--line);
    width: 100%;
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: left;
    color: var(--text);
  }

  .svc__toggle-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition:
      transform var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .svc__toggle:hover .svc__toggle-icon,
  .svc__toggle:focus-visible .svc__toggle-icon {
    border-color: var(--c-cyan);
    color: var(--c-cyan);
  }

  .svc__toggle[aria-expanded='true'] .svc__toggle-icon {
    transform: rotate(135deg);
    background: var(--c-cyan);
    border-color: var(--c-cyan);
    color: var(--c-night);
  }

  /* Height animates via grid rows 0fr → 1fr (no JS measuring).
     Without JS the details are simply shown and the toggle is hidden. */
  .svc__panel {
    display: grid;
    grid-template-rows: 1fr;
  }

  .svc__panel-inner {
    min-height: 0;
    overflow: hidden;
    display: grid;
    gap: var(--sp-5);
    align-content: start;
  }

  :global(html:not(.js)) .svc__toggle {
    display: none;
  }

  :global(html.js) .svc__panel {
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows var(--dur) var(--ease-in-out),
      visibility 0s linear var(--dur);
  }

  :global(html.js) .svc__panel-inner {
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  :global(html.js) .svc[data-open='true'] .svc__panel {
    grid-template-rows: 1fr;
    visibility: visible;
    transition:
      grid-template-rows var(--dur-slow) var(--ease-out),
      visibility 0s;
  }

  :global(html.js) .svc[data-open='true'] .svc__panel-inner {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--dur) var(--ease-out) 120ms,
      transform var(--dur-slow) var(--ease-out) 80ms;
  }

  .svc__details {
    display: grid;
    gap: var(--sp-3);
    padding: var(--sp-2) 0 0;
    list-style: none;
  }

  .svc__details li {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    color: var(--text);
    font-size: var(--fs-sm);
  }

  .svc__details li :global(svg) {
    flex: none;
    margin-top: 0.2em;
    color: var(--c-cyan);
  }

  @media (min-width: 640px) {
    .svc--lg .svc__details,
    .svc--xl .svc__details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--sp-6);
    }
  }
</style>
