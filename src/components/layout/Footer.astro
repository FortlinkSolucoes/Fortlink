---
import '@fontsource/instrument-serif/latin-400-italic.css';
import { nav, services, site, whatsappLink } from '@/data/site';
import Logo from '@/components/ui/Logo.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import PulseDot from '@/components/ui/PulseDot.astro';

interface Props {
  /** Big closing CTA. Turn off on pages that already end with their own call to action. */
  cta?: boolean;
}

const { cta = true } = Astro.props;
const { street, zip, city, state } = site.address;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${street}, ${city} - ${state}, ${zip}`)}`;
const wordmark = site.shortName.toUpperCase();
// Alfa #6 "human location" close: who and where, not a second copy of the offer (OfferBand owns it).
const telHref = `tel:+${site.whatsapp}`;
---

<footer class:list={['ftr', { 'ftr--no-cta': !cta }]} data-footer>
  <div class="ftr-bg" aria-hidden="true"></div>

  {cta && (
  <section class="container ftr-cta" aria-labelledby="ftr-cta-title" data-ftr-cta data-wa-hide>
    <PulseDot as="p" label={`${city} · ${state}`} class="ftr-badge" />
    <h2 id="ftr-cta-title" class="ftr-title t-display" data-split>
      O melhor jeito de entender é <em class="ftr-em">conversar</em> com a gente.
    </h2>

    <div class="ftr-link" aria-hidden="true">
      <svg viewBox="0 0 600 24" preserveAspectRatio="none" focusable="false">
      <defs>
        <linearGradient id="ftr-link-grad" x1="0" x2="600" y1="0" y2="0" gradientUnits="userSpaceOnUse">
          <stop offset="0" style="stop-color: var(--c-cyan)"></stop>
          <stop offset="0.55" style="stop-color: var(--c-blue)"></stop>
          <stop offset="1" style="stop-color: var(--c-magenta)"></stop>
        </linearGradient>
      </defs>
      <line class="ftr-link-base" x1="6" y1="12" x2="594" y2="12"></line>
      <line class="ftr-link-pulse" x1="6" y1="12" x2="594" y2="12" pathLength="100"></line>
    </svg>
      <span class="ftr-node"></span><span class="ftr-node"></span>
    </div>

    <p class="ftr-lead muted">
      Estamos na <a class="ftr-lead-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">{street}, {city}<span class="sr-only"> (ver no mapa, abre em nova aba)</span></a>.
      Chame no WhatsApp ou ligue: {site.whatsappDisplay}.
    </p>
    <div class="ftr-actions">
      <Button href={whatsappLink()} variant="primary" icon="whatsapp" external magnetic>
        Falar no WhatsApp
      </Button>
      <Button href={telHref} variant="ghost" icon="phone">Ligar {site.whatsappDisplay}</Button>
    </div>
  </section>
  )}

  <div class="container ftr-grid">
    <div class="ftr-brand">
      <a href="/" class="ftr-logo" aria-label={`${site.name} — página inicial`}>
        <Logo variant="full" animated />
      </a>
      <p class="muted">{site.description}</p>
    </div>

    <nav class="ftr-col" aria-labelledby="ftr-nav-title">
      <h2 id="ftr-nav-title" class="ftr-col-title">Navegação</h2>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="ftr-col" aria-labelledby="ftr-services-title">
      <h2 id="ftr-services-title" class="ftr-col-title">Serviços</h2>
      <ul class="ftr-services">
        {
          services.map((s) => (
            <li>
              <a href={`/servicos/#${s.slug}`}>{s.title}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ftr-col">
      <h2 class="ftr-col-title">Contato</h2>
      <ul class="ftr-contact">
        <li>
          <a href={`mailto:${site.email}`}><Icon name="mail" size={18} />{site.email}</a>
        </li>
        <li>
          <a href={whatsappLink()} target="_blank" rel="noopener noreferrer">
            <Icon name="whatsapp" size={18} />{site.whatsappDisplay}
            <span class="sr-only">(WhatsApp, abre em nova aba)</span>
          </a>
        </li>
        <li>
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer">
            <Icon name="pin" size={18} />
            <address>
              {street}<br />{city} — {state}, {zip}
            </address>
            <span class="sr-only">(ver no mapa, abre em nova aba)</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="ftr-wordmark" data-wordmark aria-hidden="true">
    <svg viewBox="0 0 1000 132" focusable="false">
      <defs>
        <linearGradient id="ftr-wm-grad" x1="0" x2="1000" y1="0" y2="0" gradientUnits="userSpaceOnUse">
          <stop offset="0" style="stop-color: var(--c-cyan)"></stop>
          <stop offset="0.4" style="stop-color: var(--c-blue)"></stop>
          <stop offset="0.75" style="stop-color: var(--c-magenta)"></stop>
          <stop offset="1" style="stop-color: var(--c-pink)"></stop>
        </linearGradient>
        <radialGradient id="ftr-wm-spot-grad">
          <stop offset="0" stop-color="#fff"></stop>
          <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
        </radialGradient>
        <clipPath id="ftr-wm-clip">
          <rect class="ftr-wm-clip" x="0" y="0" width="1000" height="132"></rect>
        </clipPath>
        <mask id="ftr-wm-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="1000" height="132">
          <circle class="ftr-wm-spot" cx="0" cy="0" r="170" fill="url(#ftr-wm-spot-grad)"></circle>
        </mask>
      </defs>
      <text class="ftr-wm-outline" x="4" y="114" textLength="992" lengthAdjust="spacing">{wordmark}</text>
      <g clip-path="url(#ftr-wm-clip)">
        <text class="ftr-wm-fill" x="4" y="114" textLength="992" lengthAdjust="spacing">{wordmark}</text>
      </g>
      <g class="ftr-wm-hover" mask="url(#ftr-wm-mask)">
        <text class="ftr-wm-glow" x="4" y="114" textLength="992" lengthAdjust="spacing">{wordmark}</text>
      </g>
      <rect class="ftr-wm-scan" x="0" y="0" width="2" height="132"></rect>
    </svg>
  </div>

  <div class="container ftr-bottom">
    <p>© {site.year} {site.name}. Todos os direitos reservados.</p>
    <p class="ftr-bottom-loc">{city} — {state}, Brasil</p>
    <button type="button" class="ftr-top" data-to-top>
      Voltar ao topo
      <span class="ftr-top-icon" aria-hidden="true"><Icon name="arrow-up-right" size={16} /></span>
    </button>
  </div>
</footer>

<style>
  .ftr {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-top: 1px solid var(--line);
    background: var(--bg);
  }

  .ftr-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(60% 40% at 50% 0%, color-mix(in srgb, var(--c-blue) 22%, transparent), transparent 70%),
      radial-gradient(40% 30% at 90% 85%, color-mix(in srgb, var(--c-magenta) 12%, transparent), transparent 70%);
  }

  .ftr-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(70% 45% at 50% 0%, #000, transparent 80%);
    -webkit-mask-image: radial-gradient(70% 45% at 50% 0%, #000, transparent 80%);
    opacity: 0.6;
  }

  /* ---------- CTA ---------- */
  .ftr-cta {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--sp-5);
    padding-block: var(--section-y);
  }

  /* Offer label as a glass pill around the shared live dot. */
  .ftr-cta :global(.ftr-badge) {
    padding: var(--sp-2) var(--sp-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    background: var(--bg-elev);
  }

  .ftr-title {
    max-width: 18ch;
    text-wrap: balance;
  }

  /* The one accent: serif italic emphasis (Alfa technique), in the brand gradient. */
  .ftr-em {
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    font-size: 1.08em; /* serif x-height is smaller than Sora's */
    letter-spacing: -0.01em;
    padding-inline: 0.04em 0.1em; /* keep the italic overhang inside the clipped background */
    background: var(--grad-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .ftr--no-cta .ftr-grid {
    border-top: 0;
  }

  .ftr-link {
    position: relative;
    width: min(100%, 520px);
    height: 24px;
  }

  .ftr-link svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ftr-link line {
    fill: none;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .ftr-link-base {
    stroke: var(--line-strong);
    stroke-width: 1;
  }

  .ftr-link-pulse {
    stroke: url(#ftr-link-grad);
    stroke-width: 2;
    stroke-dasharray: 18 82;
    stroke-dashoffset: 18;
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--c-cyan) 60%, transparent));
  }

  /* A few pulses when the CTA arrives on screen — not an endless loop. */
  .ftr-cta.is-inview .ftr-link-pulse {
    animation: ftr-pulse 2.6s var(--ease-in-out) 3;
  }

  @keyframes ftr-pulse {
    from {
      stroke-dashoffset: 18;
    }
    to {
      stroke-dashoffset: -100;
    }
  }

  /* Endpoint nodes are HTML so they stay round on the stretched SVG. */
  .ftr-node {
    position: absolute;
    top: 50%;
    left: 0;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    border-radius: 50%;
    background: var(--c-cyan);
    box-shadow: var(--glow-sm);
  }

  .ftr-node:last-child {
    left: auto;
    right: 0;
    background: var(--c-magenta);
    box-shadow: none;
  }

  .ftr-lead {
    max-width: 48ch;
    font-size: var(--fs-md);
  }

  .ftr-lead-link {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }

  .ftr-lead-link:is(:hover, :focus-visible) {
    text-decoration-color: var(--c-cyan);
  }

  .ftr-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-3);
    margin-top: var(--sp-3);
  }

  /* ---------- Columns ---------- */
  .ftr-grid {
    display: grid;
    gap: var(--sp-7) var(--sp-6);
    padding-block: var(--sp-8);
    border-top: 1px solid var(--line);
  }

  .ftr-brand {
    display: grid;
    gap: var(--sp-5);
    align-content: start;
    max-width: 38ch;
    font-size: var(--fs-sm);
  }

  .ftr-logo {
    justify-self: start;
    border-radius: var(--r-sm);
  }

  .ftr-logo :global(svg) {
    width: auto;
    height: 64px;
  }

  /* Trace pulse only while the brand is hovered/focused. */
  .ftr-logo :global(.logo-pulse path),
  .ftr-logo :global(.logo-node--end) {
    animation-name: none;
  }

  .ftr-logo:hover :global(.logo-pulse path),
  .ftr-logo:focus-visible :global(.logo-pulse path) {
    animation-name: logo-pulse;
  }

  .ftr-col-title {
    margin-bottom: var(--sp-4);
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .ftr-col ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-3);
    font-size: var(--fs-sm);
  }

  .ftr-col a {
    position: relative;
    display: inline-flex;
    align-items: flex-start;
    gap: var(--sp-2);
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .ftr-col a:hover,
  .ftr-col a:focus-visible {
    color: var(--text);
  }

  .ftr-col ul:not(.ftr-contact) a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: var(--grad-brand);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur) var(--ease-out);
  }

  .ftr-col ul:not(.ftr-contact) a:hover::after,
  .ftr-col ul:not(.ftr-contact) a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .ftr-contact a {
    overflow-wrap: anywhere;
  }

  .ftr-contact :global(svg) {
    flex: none;
    margin-top: 0.2em;
    color: var(--accent);
  }

  .ftr-contact address {
    font-style: normal;
  }

  @media (min-width: 640px) {
    .ftr-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ftr-brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 960px) {
    .ftr-grid {
      grid-template-columns: 1.5fr 0.8fr 1.2fr 1.2fr;
    }

    .ftr-brand {
      grid-column: auto;
    }
  }

  /* ---------- Wordmark ---------- */
  .ftr-wordmark {
    width: min(100% - 2 * var(--gutter), var(--container));
    margin-inline: auto;
    padding-block: var(--sp-5) var(--sp-6);
  }

  .ftr-wordmark svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .ftr-wordmark text {
    font-family: var(--font-display);
    font-size: 128px;
    letter-spacing: 0;
  }

  .ftr-wm-outline {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  /* Static state (no JS / reduced motion): gradient already revealed. */
  .ftr-wm-fill {
    fill: url(#ftr-wm-grad);
    opacity: 0.9;
  }

  .ftr-wm-glow {
    fill: url(#ftr-wm-grad);
    filter: drop-shadow(0 0 14px color-mix(in srgb, var(--c-magenta) 60%, transparent));
  }

  .ftr-wm-hover {
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
  }

  .ftr-wordmark.is-hover .ftr-wm-hover {
    opacity: 1;
  }

  .ftr-wm-scan {
    fill: var(--c-cyan);
    opacity: 0;
    filter: drop-shadow(0 0 8px color-mix(in srgb, var(--c-cyan) 90%, transparent));
  }

  /* ---------- Bottom bar ---------- */
  .ftr-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3) var(--sp-6);
    padding-block: var(--sp-5) var(--sp-6);
    border-top: 1px solid var(--line);
    font-size: var(--fs-xs);
    color: var(--text-dim);
  }

  .ftr-bottom-loc {
    font-family: var(--font-display);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .ftr-top {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-2) var(--sp-4);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    color: var(--text-muted);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .ftr-top:hover,
  .ftr-top:focus-visible {
    border-color: var(--line-strong);
    color: var(--text);
  }

  .ftr-top-icon {
    display: inline-flex;
    transform: rotate(-45deg);
    transition: transform var(--dur) var(--ease-out);
  }

  .ftr-top:hover .ftr-top-icon {
    transform: rotate(-45deg) translate(2px, -2px);
  }
</style>

<script>
  import { gsap, onMotionReady, prefersReducedMotion, isTouch, getLenis } from '@/scripts/motion';

  const footer = document.querySelector<HTMLElement>('[data-footer]');

  footer?.querySelector('[data-to-top]')?.addEventListener('click', () => {
    const lenis = getLenis();
    if (lenis) lenis.scrollTo(0, { duration: 1.6 });
    else window.scrollTo({ top: 0, behavior: prefersReducedMotion() ? 'auto' : 'smooth' });
    // Move focus to the start of the document without a second jump.
    document.querySelector<HTMLElement>('[data-header] a')?.focus({ preventScroll: true });
  });

  onMotionReady(() => {
    if (!footer || prefersReducedMotion()) return;
    const ctaEl = footer.querySelector<HTMLElement>('[data-ftr-cta]');
    if (ctaEl) {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          ctaEl.classList.add('is-inview');
          io.disconnect();
        },
        { threshold: 0.4 },
      );
      io.observe(ctaEl);
    }

    const wm = footer.querySelector<HTMLElement>('[data-wordmark]');
    if (!wm) return;
    const clip = wm.querySelector<SVGRectElement>('.ftr-wm-clip');
    const scan = wm.querySelector<SVGRectElement>('.ftr-wm-scan');
    const spot = wm.querySelector<SVGCircleElement>('.ftr-wm-spot');

    // Scroll: the gradient "signal" fills the outlined wordmark left → right.
    if (clip && scan) {
      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: { trigger: wm, start: 'top 95%', end: 'bottom 70%', scrub: 0.8 },
      });
      tl.fromTo(clip, { scaleX: 0, transformOrigin: '0% 50%' }, { scaleX: 1 }, 0)
        .fromTo(scan, { x: 0, opacity: 1 }, { x: 998 }, 0)
        .to(scan, { opacity: 0, duration: 0.08 }, 0.92);
    }

    // Hover: a neon spotlight follows the pointer (transform only).
    if (spot && !isTouch()) {
      const svg = wm.querySelector('svg')!;
      const toX = gsap.quickTo(spot, 'x', { duration: 0.6, ease: 'power3.out' });
      const toY = gsap.quickTo(spot, 'y', { duration: 0.6, ease: 'power3.out' });
      wm.addEventListener('pointerenter', () => wm.classList.add('is-hover'));
      wm.addEventListener('pointerleave', () => wm.classList.remove('is-hover'));
      wm.addEventListener('pointermove', (e) => {
        const r = svg.getBoundingClientRect();
        const s = 1000 / r.width;
        toX((e.clientX - r.left) * s);
        toY((e.clientY - r.top) * s);
      });
    }
  });
</script>
