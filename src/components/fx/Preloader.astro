---
// Brand intro (home only, once per session). The circuit "F" draws itself, a counter runs
// to 100 and the screen exits with an upward wipe. Never shown without JS or with reduced
// motion. Always emits `preloader:done` on window (immediately when skipped) and adds
// `.preloader-done` to <html> so late listeners can check it.
import { site } from '@/data/site';

const STORAGE_KEY = 'fl:preloader';

// Simplified circuit F (viewBox 0 0 200 220): outline, inner traces, branch leads, nodes.
const outline =
  'M40 50 L66 22 L172 22 L146 50 L82 50 L72 60 L72 76 L82 86 L152 86 L126 114 L80 114 L72 122 L72 182 L56 200 L40 184 Z';
const traces = [
  'M50 178 L50 56 L70 34 L152 34',
  'M60 170 L60 64 L76 44 L134 44',
  'M60 104 L68 96 L138 96',
  'M64 160 L64 126 L72 118',
  'M90 40 L118 40',
];
const leads = [
  { d: 'M40 70 L14 70', node: [10, 70] },
  { d: 'M40 102 L22 102', node: [18, 102] },
  { d: 'M40 132 L8 132', node: [4, 132] },
  { d: 'M66 22 L66 8', node: [66, 4] },
  { d: 'M150 22 L150 8', node: [150, 4] },
  { d: 'M110 114 L110 136', node: [110, 140] },
  { d: 'M100 50 L100 64', node: [100, 68] },
];
const tips = [
  [172, 22],
  [152, 86],
  [56, 200],
];
---

<script is:inline define:vars={{ STORAGE_KEY }}>
  // Decide before first paint whether the intro plays (avoids a one-frame flash).
  try {
    if (sessionStorage.getItem(STORAGE_KEY)) document.documentElement.classList.add('preloader-skip');
  } catch (_) {
    /* storage blocked: just play it */
  }
</script>

<div class="preloader" data-preloader aria-hidden="true">
  <div class="preloader__inner">
    <svg class="preloader__mark" viewBox="-4 -4 208 232" fill="none" role="presentation">
      <defs>
        <linearGradient id="pl-grad" x1="0" y1="0" x2="200" y2="220" gradientUnits="userSpaceOnUse">
          <stop offset="0" style="stop-color: var(--c-cyan)"></stop>
          <stop offset="0.45" style="stop-color: var(--c-blue)"></stop>
          <stop offset="0.8" style="stop-color: var(--c-magenta)"></stop>
          <stop offset="1" style="stop-color: var(--c-pink)"></stop>
        </linearGradient>
        <filter id="pl-glow" x="-30%" y="-30%" width="160%" height="160%">
          <feGaussianBlur stdDeviation="3.2" result="b"></feGaussianBlur>
          <feMerge>
            <feMergeNode in="b"></feMergeNode>
            <feMergeNode in="SourceGraphic"></feMergeNode>
          </feMerge>
        </filter>
      </defs>
      <g stroke="url(#pl-grad)" stroke-linecap="round" stroke-linejoin="round" filter="url(#pl-glow)">
        <path class="pl-draw pl-outline" d={outline} pathLength="1" stroke-width="2.4"></path>
        {traces.map((d) => <path class="pl-draw pl-trace" d={d} pathLength="1" stroke-width="1.2" />)}
        {leads.map((l) => <path class="pl-draw pl-lead" d={l.d} pathLength="1" stroke-width="1" />)}
      </g>
      <g class="pl-nodes" stroke="url(#pl-grad)" stroke-width="1.4">
        {leads.map((l) => <circle class="pl-node" cx={l.node[0]} cy={l.node[1]} r="3.2" />)}
        {tips.map((t) => <circle class="pl-node" cx={t[0]} cy={t[1]} r="4" />)}
      </g>
    </svg>

    <div class="preloader__meta">
      <p class="preloader__word">{site.shortName.toUpperCase()}</p>
      <div class="preloader__bar"><span data-preloader-bar></span></div>
      <p class="preloader__count"><span data-preloader-count>000</span><sup>%</sup></p>
    </div>
  </div>
</div>

<script>
  import { gsap, onMotionReady, getLenis, prefersReducedMotion } from '@/scripts/motion';

  const KEY = 'fl:preloader';
  const root = document.documentElement;
  const el = document.querySelector<HTMLElement>('[data-preloader]');

  const finish = () => {
    if (root.classList.contains('preloader-done')) return;
    root.classList.add('preloader-done');
    el?.remove();
    window.dispatchEvent(new Event('preloader:done'));
  };

  if (!el || prefersReducedMotion() || root.classList.contains('preloader-skip')) {
    finish();
  } else {
    try {
      sessionStorage.setItem(KEY, '1');
    } catch {
      /* storage blocked: ignore */
    }
    onMotionReady(() => {
      if (!root.classList.contains('preloader-done')) getLenis()?.stop();
    });

    const count = el.querySelector<HTMLElement>('[data-preloader-count]');
    const bar = el.querySelector<HTMLElement>('[data-preloader-bar]');
    const counter = { v: 0 };

    const tl = gsap.timeline({
      defaults: { ease: 'power2.inOut' },
      onComplete: () => {
        getLenis()?.start();
        finish();
      },
    });

    // Total ≈ 1.8s: draw (0–1.1s) → flash (1.15s) → wipe out (1.3–1.8s).
    tl.to(el.querySelectorAll('.pl-outline'), { strokeDashoffset: 0, duration: 1.05 }, 0)
      .to(el.querySelectorAll('.pl-trace'), { strokeDashoffset: 0, duration: 0.7, stagger: 0.07 }, 0.25)
      .to(el.querySelectorAll('.pl-lead'), { strokeDashoffset: 0, duration: 0.35, stagger: 0.04 }, 0.55)
      .to(el.querySelectorAll('.pl-node'), { scale: 1, opacity: 1, duration: 0.35, stagger: 0.03, ease: 'back.out(3)' }, 0.75)
      .to(
        counter,
        {
          v: 100,
          duration: 1.2,
          ease: 'power3.inOut',
          onUpdate: () => {
            const n = Math.round(counter.v);
            if (count) count.textContent = String(n).padStart(3, '0');
            if (bar) bar.style.transform = `scaleX(${n / 100})`;
          },
        },
        0,
      )
      .to(el.querySelector('.preloader__mark'), { scale: 1.08, duration: 0.3, ease: 'power2.out' }, 1.1)
      .to(el.querySelector('.preloader__inner'), { opacity: 0, y: -32, duration: 0.35, ease: 'power2.in' }, 1.3)
      .to(el, { clipPath: 'polygon(0% 0%, 100% 0%, 100% 0%, 0% 0%)', duration: 0.5, ease: 'expo.inOut' }, 1.3);
  }
</script>

<style>
  .preloader {
    display: none;
  }

  :global(html.js:not(.reduced-motion):not(.preloader-skip)) .preloader {
    position: fixed;
    inset: 0;
    z-index: var(--z-loader);
    display: grid;
    place-items: center;
    background:
      radial-gradient(60% 50% at 50% 45%, color-mix(in srgb, var(--c-violet) 55%, transparent), transparent 70%),
      var(--bg);
    clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%);
    /* Failsafe: never trap the user if the script fails to load. */
    animation: preloader-failsafe 0.4s var(--ease-out) 4.5s forwards;
  }

  @keyframes preloader-failsafe {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  .preloader__inner {
    display: grid;
    justify-items: center;
    gap: var(--sp-6);
  }

  .preloader__mark {
    width: clamp(96px, 22vw, 150px);
    height: auto;
    overflow: visible;
  }

  .pl-draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .pl-trace,
  .pl-lead {
    opacity: 0.85;
  }

  .pl-nodes {
    fill: var(--c-night);
  }

  .pl-node {
    opacity: 0;
    transform: scale(0);
    transform-box: fill-box;
    transform-origin: center;
  }

  .preloader__meta {
    display: grid;
    justify-items: center;
    gap: var(--sp-3);
    width: min(240px, 60vw);
  }

  .preloader__word {
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    letter-spacing: 0.5em;
    margin-right: -0.5em;
    color: var(--text-muted);
  }

  .preloader__bar {
    width: 100%;
    height: 1px;
    background: var(--line);
    overflow: hidden;
  }

  .preloader__bar span {
    display: block;
    height: 100%;
    background: var(--grad-brand);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .preloader__count {
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    letter-spacing: 0.2em;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .preloader__count sup {
    font-size: 0.6em;
    color: var(--accent);
    margin-left: 0.2em;
  }
</style>
