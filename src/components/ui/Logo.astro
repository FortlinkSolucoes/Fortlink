---
/**
 * FortLink brand mark: the circuit "F" (chamfered 45° outline, parallel traces,
 * nodes and leads) with the brand gradient. `full` adds the FORTLINK / SOLUÇÕES wordmark.
 *
 * Sizing: set `--logo-h` (default 2.25rem mark / 2.75rem full) or width/height on the class.
 * Contract hooks: traces have `.logo-trace`, nodes `.logo-node` (Preloader animates them).
 */
interface Props {
  variant?: 'full' | 'mark';
  class?: string;
  animated?: boolean;
  [attr: string]: unknown;
}

const { variant = 'mark', class: className, animated = false, ...rest } = Astro.props;

// Unique per instance so several logos on one page never share gradient/filter ids.
const uid = `fl${Math.random().toString(36).slice(2, 8)}`;
const gradId = `${uid}-grad`;
const fillId = `${uid}-fill`;

// Geometry (viewBox 0 0 100 116). Outline of the F with 45° chamfers.
const outline = 'M32 14H94L78 30H48L40 38V50H82L68 64H40V110L22 92V24Z';

// Parallel circuit traces running inside the letter.
const traces = ['M28 90V27L35 20H84', 'M34 98V32L42 24H72', 'M34 57H71', 'M47 53H63'];

// Leads leaving the letter towards the left/top/bottom (end in dots or rings).
const leads = [
  'M22 40H10',
  'M22 56H13.5',
  'M22 70H10',
  'M22 82H15.5',
  'M27 19L15.5 7.5',
  'M40 14V6',
  'M60 14V8.5',
  'M86 14V6',
  'M58 30V37.5',
  'M52 64V73.5',
];

// [cx, cy, r, kind] — "end" = big terminal node, "dot" = solid pad, "ring" = via.
const nodes: Array<[number, number, number, 'end' | 'dot' | 'ring']> = [
  [94, 14, 2.8, 'end'],
  [82, 50, 2.8, 'end'],
  [40, 110, 2.8, 'end'],
  [84, 20, 1.5, 'dot'],
  [72, 24, 1.5, 'dot'],
  [71, 57, 1.5, 'dot'],
  [63, 53, 1.3, 'dot'],
  [28, 90, 1.5, 'dot'],
  [34, 98, 1.5, 'dot'],
  [34, 57, 1.5, 'dot'],
  [7.5, 40, 2.5, 'ring'],
  [11.5, 56, 2.2, 'dot'],
  [7.5, 70, 2.5, 'ring'],
  [14, 82, 1.6, 'dot'],
  [14, 6, 1.8, 'dot'],
  [40, 4, 2.1, 'dot'],
  [60, 7, 1.5, 'dot'],
  [86, 3.5, 2.3, 'ring'],
  [58, 40, 2.3, 'ring'],
  [52, 76, 2.3, 'ring'],
];

const isFull = variant === 'full';
---

<span
  class:list={['logo', `logo--${variant}`, { 'logo--animated': animated }, className]}
  role="img"
  aria-label="FortLink Soluções"
  {...rest}
>
  <svg class="logo__mark" viewBox="0 0 100 116" fill="none" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={gradId} gradientUnits="userSpaceOnUse" x1="4" y1="10" x2="96" y2="100">
        <stop offset="0" class="stop-cyan" />
        <stop offset="0.42" class="stop-blue" />
        <stop offset="0.72" class="stop-magenta" />
        <stop offset="1" class="stop-pink" />
      </linearGradient>
      <linearGradient id={fillId} gradientUnits="userSpaceOnUse" x1="22" y1="14" x2="94" y2="110">
        <stop offset="0" class="stop-cyan" stop-opacity="0.55" />
        <stop offset="0.5" class="stop-blue" stop-opacity="0.5" />
        <stop offset="1" class="stop-magenta" stop-opacity="0.55" />
      </linearGradient>
    </defs>
    <g stroke={`url(#${gradId})`} stroke-linecap="round" stroke-linejoin="round">
      <path class="logo-fill" d={outline} fill={`url(#${fillId})`} stroke="none" />
      <g class="logo-leads" stroke-width="1.3">
        {leads.map((d) => <path class="logo-trace logo-lead" d={d} pathLength="100" />)}
      </g>
      <g class="logo-inner" stroke-width="1.5">
        {traces.map((d) => <path class="logo-trace" d={d} pathLength="100" />)}
      </g>
      <path class="logo-trace logo-outline" d={outline} stroke-width="3" pathLength="100" />
      {
        animated && (
          <g class="logo-pulse" stroke-width="2">
            {[outline, ...traces, ...leads.slice(0, 4)].map((d) => (
              <path d={d} pathLength="100" />
            ))}
          </g>
        )
      }
      <g class="logo-nodes">
        {
          nodes.map(([cx, cy, r, kind]) =>
            kind === 'ring' ? (
              <circle class="logo-node logo-node--ring" cx={cx} cy={cy} r={r} stroke-width="1.3" fill="none" />
            ) : (
              <circle
                class:list={['logo-node', `logo-node--${kind}`]}
                cx={cx}
                cy={cy}
                r={r}
                fill={`url(#${gradId})`}
                stroke="none"
              />
            ),
          )
        }
      </g>
    </g>
  </svg>
  {
    isFull && (
      <span class="logo__word" aria-hidden="true">
        <span class="logo__name">FORTLINK</span>
        <span class="logo__sub">SOLUÇÕES</span>
      </span>
    )
  }
</span>

<style>
  /* Defaults live in :where() so a consumer class can override size freely
     (set --logo-h, or height/width on the class). */
  :where(.logo) {
    --logo-h: 2.25rem;
    display: inline-flex;
    align-items: center;
    color: var(--text);
    line-height: 1;
    vertical-align: middle;
  }

  :where(.logo--mark) {
    height: var(--logo-h);
    aspect-ratio: 100 / 116;
  }

  .logo--mark .logo__mark {
    width: 100%;
    height: 100%;
  }

  :where(.logo--full) {
    --logo-h: 2.75rem;
    gap: calc(var(--logo-h) * 0.3);
  }

  .logo--full .logo__mark {
    height: var(--logo-h);
    width: auto;
    aspect-ratio: 100 / 116;
    flex: none;
  }

  .logo__mark {
    overflow: visible;
    filter: drop-shadow(0 0 0.35em color-mix(in srgb, var(--c-cyan) 30%, transparent));
  }

  .stop-cyan {
    stop-color: var(--c-cyan);
  }
  .stop-blue {
    stop-color: var(--c-blue);
  }
  .stop-magenta {
    stop-color: var(--c-magenta);
  }
  .stop-pink {
    stop-color: var(--c-pink);
  }

  .logo-inner,
  .logo-leads {
    opacity: 0.9;
  }

  .logo-node--end {
    stroke: var(--c-white);
    stroke-width: 1;
    stroke-opacity: 0.85;
  }

  /* Wordmark */
  .logo__word {
    display: inline-flex;
    flex-direction: column;
    gap: calc(var(--logo-h) * 0.12);
    font-family: var(--font-display);
    white-space: nowrap;
  }

  .logo__name {
    font-size: calc(var(--logo-h) * 0.42);
    letter-spacing: 0.06em;
    color: var(--text);
    text-shadow: 0 0 0.9em color-mix(in srgb, var(--c-white) 30%, transparent);
  }

  .logo__sub {
    font-size: calc(var(--logo-h) * 0.17);
    letter-spacing: 0.72em;
    /* Optical correction: tracking adds trailing space after the last letter. */
    margin-right: -0.72em;
    color: var(--text-muted);
  }

  /* Light pulse travelling along the traces (animated=true). */
  .logo-pulse path {
    stroke: var(--c-white);
    stroke-dasharray: 7 200;
    stroke-dashoffset: 8;
    opacity: 0;
    animation: logo-pulse 4.8s var(--ease-in-out) infinite;
  }

  .logo-pulse {
    filter: drop-shadow(0 0 1.5px var(--c-white)) drop-shadow(0 0 4px var(--c-cyan));
  }

  .logo-pulse path:nth-child(2) { animation-delay: 0.5s; }
  .logo-pulse path:nth-child(3) { animation-delay: 1.1s; }
  .logo-pulse path:nth-child(4) { animation-delay: 1.9s; }
  .logo-pulse path:nth-child(5) { animation-delay: 2.6s; }
  .logo-pulse path:nth-child(6) { animation-delay: 3.1s; animation-duration: 3.6s; }
  .logo-pulse path:nth-child(7) { animation-delay: 0.9s; animation-duration: 3.6s; }
  .logo-pulse path:nth-child(8) { animation-delay: 2.2s; animation-duration: 3.6s; }
  .logo-pulse path:nth-child(9) { animation-delay: 1.5s; animation-duration: 3.6s; }

  .logo--animated .logo-node--end {
    animation: logo-breathe 2.4s var(--ease-in-out) infinite alternate;
  }

  @keyframes logo-pulse {
    0% {
      stroke-dashoffset: 8;
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    70% {
      opacity: 1;
    }
    85%,
    100% {
      stroke-dashoffset: -100;
      opacity: 0;
    }
  }

  @keyframes logo-breathe {
    to {
      stroke-opacity: 0.3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-pulse {
      display: none;
    }
    .logo--animated .logo-node--end {
      animation: none;
    }
  }

  :global(html.reduced-motion) .logo-pulse {
    display: none;
  }
</style>
