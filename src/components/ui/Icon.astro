---
/**
 * Line icon set (24×24 grid, stroke 1.5, currentColor). Decorative by default:
 * give the parent control an accessible name instead.
 */
import type { IconName } from '@/data/site';

export type UiIconName =
  | IconName
  | 'arrow-right'
  | 'arrow-up-right'
  | 'check'
  | 'whatsapp'
  | 'mail'
  | 'pin'
  | 'phone'
  | 'clock'
  | 'menu'
  | 'close'
  | 'plus';

interface Props {
  name: UiIconName;
  size?: number;
  class?: string;
  [attr: string]: unknown;
}

const { name, size = 24, class: className, ...rest } = Astro.props;

const handset =
  'M6.2 3.8h2.6l1.5 3.9-1.9 1.3a10.6 10.6 0 0 0 4.6 4.6l1.3-1.9 3.9 1.5v2.6a2 2 0 0 1-2.2 2A15.2 15.2 0 0 1 4.2 6a2 2 0 0 1 2-2.2Z';

const icons: Record<UiIconName, string> = {
