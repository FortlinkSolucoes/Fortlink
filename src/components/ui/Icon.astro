    '<rect x="9" y="3" width="6" height="4.5" rx="1.2"/><rect x="2.75" y="16.5" width="6" height="4.5" rx="1.2"/><rect x="15.25" y="16.5" width="6" height="4.5" rx="1.2"/><path d="M12 7.5v9M5.75 16.5V14a1.5 1.5 0 0 1 1.5-1.5h9.5a1.5 1.5 0 0 1 1.5 1.5v2.5"/><circle cx="12" cy="12.5" r=".9" fill="currentColor" stroke="none"/>',
  cable:
    '<rect x="7" y="3" width="10" height="10" rx="1.6"/><path d="M10 3v3M12 3v3M14 3v3M9.5 13v2.5a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1V13M12 16.5V21"/>',
  support:
    '<path d="M4.5 13.5V12a7.5 7.5 0 0 1 15 0v1.5"/><rect x="3" y="13" width="4" height="6" rx="1.5"/><rect x="17" y="13" width="4" height="6" rx="1.5"/><path d="M19 19c0 1.7-1.3 2.5-3 2.5h-2.5"/>',
  datacenter:
    '<rect x="4" y="3" width="16" height="5.2" rx="1.4"/><rect x="4" y="9.4" width="16" height="5.2" rx="1.4"/><rect x="4" y="15.8" width="16" height="5.2" rx="1.4"/><path d="M13 5.6h4M13 12h4M13 18.4h4"/><circle cx="7.5" cy="5.6" r=".9" fill="currentColor" stroke="none"/><circle cx="7.5" cy="12" r=".9" fill="currentColor" stroke="none"/><circle cx="7.5" cy="18.4" r=".9" fill="currentColor" stroke="none"/>',
  cctv:
    '<path d="M3.2 8.1 15.6 4.5a1 1 0 0 1 1.2.7l1.4 4.8a1 1 0 0 1-.7 1.2L5.1 14.8a1 1 0 0 1-1.2-.7L2.5 9.3a1 1 0 0 1 .7-1.2Z"/><path d="m18 7.8 3.1-.9.9 3.1-3.1.9M8.4 13.8l1 3.4H4.5M3.5 14.8v5.7"/><circle cx="14.3" cy="8.6" r=".9" fill="currentColor" stroke="none"/>',
  voip: `<path d="${handset}"/><path d="M14.5 3.2a6.5 6.5 0 0 1 6.3 6.3M14.5 6.4a3.3 3.3 0 0 1 3.1 3.1"/>`,
  shield:
    '<path d="M12 2.8 19.5 5.6v5.9c0 4.4-3.1 8.2-7.5 9.7-4.4-1.5-7.5-5.3-7.5-9.7V5.6Z"/><path d="m8.8 12 2.2 2.2 4.3-4.4"/>',
  noc:
    '<rect x="2.75" y="3.5" width="18.5" height="12.5" rx="2"/><path d="M8.5 20.5h7M12 16v4.5M6 10h2.6l1.6-3 2.6 6 1.6-3H18"/>',
  wifi:
    '<path d="M2.5 8.8a13.8 13.8 0 0 1 19 0M5.6 12.2a9.4 9.4 0 0 1 12.8 0M8.7 15.6a4.9 4.9 0 0 1 6.6 0"/><circle cx="12" cy="19" r="1.1" fill="currentColor" stroke="none"/>',
  process:
